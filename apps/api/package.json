{
  "name": "@csw/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db:migrate": "tsx src/migrate.ts",
    "build": "tsup src/index.ts --format esm --platform node --out-dir dist --clean",
    "start": "node dist/index.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/raw-body": "^5.0.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.0.0",
    "file-type": "^21.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.0.0",
    "stripe": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
