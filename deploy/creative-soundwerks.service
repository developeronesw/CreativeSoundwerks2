[Unit]
Description=Creative Soundwerks 2 API
After=network-online.target postgresql.service
Wants=network-online.target
[Service]
Type=simple
User=csw
Group=csw
WorkingDirectory=/opt/creative-soundwerks
Environment=CSW_INSTALL_ROOT=/opt/creative-soundwerks
Environment=CSW_CONFIG_PATH=/opt/creative-soundwerks/.env
Environment=CSW_UPDATE_ROOT=/var/lib/creative-soundwerks/updates
ExecStart=/usr/bin/node /opt/creative-soundwerks/scripts/update-boot.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=COOKIE_SECURE=true
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/creative-soundwerks/media /var/lib/creative-soundwerks/updates
CapabilityBoundingSet=
UMask=0077
[Install]
WantedBy=multi-user.target
